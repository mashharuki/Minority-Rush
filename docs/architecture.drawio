<mxfile host="app.diagrams.net">
  <diagram id="minority-rush-arch" name="System architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Minority Rush — System architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="player" value="Player&lt;br&gt;(mobile browser / installed PWA)" style="shape=umlActor;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="195" y="65" width="30" height="55" as="geometry" />
        </mxCell>

        <!-- Web app -->
        <mxCell id="g_web" value="apps/web — Vite + React PWA (Vercel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#2563eb;dashed=1;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="360" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="React 19 UI&lt;br&gt;Home / Play / Result, streak, share grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="viem" value="viem + permissionless&lt;br&gt;ERC-4337 smart account, UserOps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="privysdk" value="Privy SDK&lt;br&gt;email login + embedded wallet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="370" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zamasdk" value="@zama-fhe/sdk&lt;br&gt;encrypt input, user / public decrypt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="450" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sw" value="Service worker (Workbox)&lt;br&gt;caches app shell and fonts only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Middle: off-chain services -->
        <mxCell id="pimlico" value="Pimlico&lt;br&gt;Bundler + Paymaster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="175" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sponsor" value="apps/sponsor-api (Vercel Function)&lt;br&gt;verifies Privy token, validates JSON-RPC,&lt;br&gt;rate limits, holds the Pimlico key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="privy" value="Privy&lt;br&gt;auth / embedded wallet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="395" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="relayer" value="Zama Relayer + KMS&lt;br&gt;relayer.testnet.zama.org&lt;br&gt;input proofs, decryption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- Sepolia -->
        <mxCell id="g_chain" value="Ethereum Sepolia (chain 11155111)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;dashed=1;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="460" height="520" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="EntryPoint (ERC-4337)&lt;br&gt;executes the player's UserOp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="200" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="game" value="MinorityRushGame&lt;br&gt;startRound / enter / closeRound /&lt;br&gt;finalizeRound / claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="300" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="chip" value="RushChip&lt;br&gt;ERC-7984 confidential token + faucet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="430" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fhevm" value="Zama FHEVM host contracts&lt;br&gt;encrypted compute (FHE.lt / eq / randEbool),&lt;br&gt;ACL, FHE.checkSignatures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="560" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Reads (viem) go to a Sepolia RPC directly. With an injected wallet, transactions are sent straight to the contracts (no sponsor). Without deployed contracts the web app runs an offline demo client. Side, stake, pools and balances stay encrypted on-chain; only addresses, player count, timing and the winning side are public."
          style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1320" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_player" value="" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="player" target="g_web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sponsor" value="JSON-RPC + Privy token" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;strokeColor=#ea580c;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="viem" target="sponsor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pimlico" value="sponsored UserOp" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;strokeColor=#ea580c;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sponsor" target="pimlico">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bundle" value="bundled UserOps" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;strokeColor=#ea580c;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pimlico" target="entry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_verify" value="verify token" style="endArrow=classic;html=1;fontSize=11;dashed=1;strokeColor=#9333ea;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sponsor" target="privy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_login" value="email login" style="endArrow=classic;html=1;fontSize=11;strokeColor=#9333ea;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="privysdk" target="privy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_relayer" value="encrypt / decrypt requests" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;strokeWidth=2;strokeColor=#ca8a04;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="zamasdk" target="relayer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_proofs" value="proofs, decryption signatures" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;strokeColor=#ca8a04;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="relayer" target="fhevm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_entry_game" value="enter / claim" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;strokeColor=#059669;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_game_chip" value="confidentialTransferFrom" style="endArrow=classic;html=1;fontSize=11;strokeColor=#059669;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="game" target="chip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_fhe" value="FHE ops, checkSignatures" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="515" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e_game_fhe" value="" style="endArrow=classic;html=1;fontSize=11;strokeColor=#ca8a04;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="game" target="fhevm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1345" y="345" />
              <mxPoint x="1345" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

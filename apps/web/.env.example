# Public values only (Vite embeds VITE_* in the browser bundle). Never put secrets here.
VITE_SEPOLIA_RPC_URL=
# Optional overrides; defaults come from src/contracts/deployment.sepolia.json
VITE_GAME_ADDRESS=
VITE_RUSH_CHIP_ADDRESS=
# Set to true to force the offline simulation
VITE_DEMO_MODE=
# Email login + gasless play (both required to enable it; otherwise only injected wallets)
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
# Public URL of apps/sponsor-api, e.g. https://minority-rush-sponsor.vercel.app/api/sponsor
VITE_SPONSOR_API_URL=

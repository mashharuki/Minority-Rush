# Server-side only (Vercel project env). Never expose these to apps/web.
PRIVY_APP_ID=
# Public verification key (PEM) or JWKS URL from the Privy dashboard (not the app secret)
PRIVY_VERIFICATION_KEY=
# Pimlico bundler/paymaster credentials (secret)
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
# Comma-separated list of web origins allowed to call the API
ALLOWED_WEB_ORIGIN=https://your-web-app.vercel.app
# Deployed contract addresses (the only call targets that get sponsored)
CHIP_ADDRESS=
GAME_ADDRESS=
RATE_LIMIT_PER_MINUTE=20
